# Plantilla de variables de entorno de AdoptMe.
# 1. Copia este archivo y renómbralo como .env (en la misma carpeta raíz).
# 2. Cambia los valores, sobre todo DB_PASSWORD y JWT_SECRET.
# 3. Nunca subas el archivo .env a Git.

# ---- Backend (NestJS) ----
# Puerto donde escucha la API. Ya lo usa backend/src/main.ts.
PORT=3000

# ---- Base de datos (PostgreSQL en Docker) ----
# Las usa docker-compose.yml para crear la base de datos
# y el backend para conectarse.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=adoptme_db

# ---- Autenticación (JWT) ----
# Secreto para firmar los tokens. Sin esta variable la app no arranca.
# Genera el tuyo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_este_secreto